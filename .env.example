# Optional: CoinDesk Data (formerly CryptoCompare) API key. When set, it is used as a
# tiebreaker for days where Yahoo and Coin Metrics closes disagree by more than 2%.
# Export it in your shell (the pipeline reads the environment, not this file):
#   PowerShell:  $env:COINDESK_API_KEY = "..."
COINDESK_API_KEY=
